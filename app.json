{
  "expo": {
    "name": "RakshaCast",
    "slug": "rakshacast",
    "version": "1.0.0",
    "orientation": "portrait",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rakshacast.app"
    },
    "android": {
      "package": "com.rakshacast.app",
      "versionCode": 1,
      "targetSdkVersion": 34,
      "compileSdkVersion": 34,
      "minSdkVersion": 26,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ab8be812-89c1-4cda-b44e-a01be11c29e5"
      }
    }
  }
}
